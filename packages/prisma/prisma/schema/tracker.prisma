// Multi-brand luxury restock alert — catalog + alerts
// Replaces old Cartier purchase tracker schema (accounts/purchases)

// -- Catalog ---------------------------------------------------------------

model watchable_units {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand        String // e.g. "Hermes", "Chanel", "Dior", "LouisVuitton"
  product_line String // brand-specific, e.g. "Birkin", "Kelly", "Classic Flap"
  model_name   String // e.g. "Birkin 25", "Kelly 28 Sellier"
  image_url    String?
  active       Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  skus    skus[]
  watches watches[]

  @@unique([brand, model_name])
  @@index([brand, product_line])
  @@index([active])
}

model skus {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  watchable_unit_id String   @db.Uuid
  color             String // e.g. "Noir", "Gold", "Etoupe"
  leather           String? // e.g. "Togo", "Epsom", "Swift"
  hardware          String? // e.g. "GHW", "PHW"
  size              String? // e.g. "25", "28", "30"
  reference_code    String?  @unique
  source_url        String? // canonical product-page URL; used by scrapers when the URL isn't derivable from reference_code (e.g. non-Tank-Must Cartier lines)
  image_url         String?
  active            Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  watchable_unit  watchable_units  @relation(fields: [watchable_unit_id], references: [id])
  drop_events     drop_events[]
  watches         watches[]
  sku_stock_state sku_stock_state?
  parse_errors    parse_errors[]

  @@index([watchable_unit_id])
  @@index([color, leather])
}

// -- Alerts ----------------------------------------------------------------

model watches {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_user_id      String   @db.Uuid
  watchable_unit_id String   @db.Uuid
  sku_id            String?  @db.Uuid
  notify_push       Boolean  @default(true)
  notify_email      Boolean  @default(false)
  active            Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  auth_user      auth_users      @relation(fields: [auth_user_id], references: [supabase_id])
  watchable_unit watchable_units @relation(fields: [watchable_unit_id], references: [id])
  sku            skus?           @relation(fields: [sku_id], references: [id])
  alerts         alerts[]

  @@unique([auth_user_id, watchable_unit_id, sku_id])
  @@index([auth_user_id, active])
  @@index([watchable_unit_id])
}

model drop_events {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku_id          String    @db.Uuid
  source_url      String?
  detected_at     DateTime  @default(now())
  expired_at      DateTime?
  idempotency_key String?   @unique

  sku    skus     @relation(fields: [sku_id], references: [id])
  alerts alerts[]

  @@index([sku_id, detected_at])
  @@index([detected_at])
}

model alerts {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  watch_id      String    @db.Uuid
  drop_event_id String    @db.Uuid
  channel       String // "push" | "email"
  sent_at       DateTime?
  read_at       DateTime?
  created_at    DateTime  @default(now())

  watch      watches     @relation(fields: [watch_id], references: [id], onDelete: Cascade)
  drop_event drop_events @relation(fields: [drop_event_id], references: [id])

  @@index([watch_id, created_at])
  @@index([drop_event_id])
}

// -- Push devices ------------------------------------------------------------

/// One row per (device install × user). Stores the Expo push token used to
/// deliver restock notifications. The token is globally unique, so an upsert
/// keyed on `expo_token` handles device hand-off (a new user signing into a
/// device previously used by someone else reassigns `auth_user_id`). Rows are
/// soft-deactivated (`active=false`) on logout or when Expo reports the token
/// as `DeviceNotRegistered`, never hard-deleted.
model push_devices {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_user_id String   @db.Uuid
  expo_token   String   @unique // "ExponentPushToken[...]"
  platform     String // "ios" | "android"
  active       Boolean  @default(true)
  last_seen_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  auth_user auth_users @relation(fields: [auth_user_id], references: [supabase_id])

  @@index([auth_user_id, active])
}

// -- Scraper state -----------------------------------------------------------

model sku_stock_state {
  sku_id             String    @id @db.Uuid
  in_stock           Boolean
  last_checked       DateTime
  last_changed       DateTime
  consecutive_errors Int       @default(0)
  /// Set when the Slack pager has fired for this SKU. Used to dedupe pages
  /// inside a cooldown window so a sustained outage doesn't spam the channel.
  last_paged_at      DateTime?

  sku skus @relation(fields: [sku_id], references: [id])
}

model parse_errors {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku_id      String?  @db.Uuid
  brand       String
  source_url  String?
  error_msg   String
  raw_payload Json
  created_at  DateTime @default(now())

  sku skus? @relation(fields: [sku_id], references: [id], onDelete: SetNull)

  @@index([brand, created_at])
}

// -- Spike: fetcher bake test (INF-1360) --------------------------------------

model fetcher_bake_results {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fetcher        String // "http" | "browser"
  url            String
  status         Int
  latency_ms     Int
  success        Boolean
  blocked        Boolean
  error_msg      String?
  content_length Int
  run_id         String
  created_at     DateTime @default(now())

  @@index([run_id, fetcher])
  @@index([created_at])
}

// -- Catalog discovery (INF-1558) --------------------------------------------

// Live products seen in a brand's category sweep. A freshness substrate ONLY —
// deliberately decoupled from the curated watchable_units/skus. The daily
// discovery job upserts one row per live article code, advancing last_seen_at;
// a row not seen for the stale TTL (14 days) is flipped is_stale. Promoting a
// discovered row into the curated catalog + poll loop is a separate, deliberate
// step (not this job).
model discovered_products {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand           String // "Hermes" (Cartier later)
  article_code    String // trailing slug token, e.g. "H086915CK37"
  url             String // full live product URL (the Korean-slug page)
  model_hint      String? // slug text before the article code, human hint only
  first_seen_at   DateTime  @default(now())
  last_seen_at    DateTime  @default(now())
  is_stale        Boolean   @default(false)
  // Availability (INF-1624): set by the discovered-products monitor, which
  // resolves each non-stale row's stock through the hardened read path. Pure
  // freshness/availability snapshot — NOT wired to drop_events/alerts.
  in_stock        Boolean? // last observed purchasable state; null = not yet checked
  last_checked_at DateTime? // last successful availability resolve
  last_changed_at DateTime? // last time in_stock flipped
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@unique([brand, article_code])
  @@index([brand, is_stale])
  @@index([brand, in_stock])
  @@index([last_seen_at])
}
